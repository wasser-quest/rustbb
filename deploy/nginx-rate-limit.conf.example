# The load balancer limits the requests, so the forum does not have to (set FORUM_RATE_LIMIT=off).
# Put this in the http block of the proxy in front of the forum. It limits sign-ups and logins
# per client address; the forum sees the real address through X-Forwarded-For (FORUM_TRUST_PROXY=true).
limit_req_zone $binary_remote_addr zone=forum_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=forum_general:10m rate=30r/s;

server {
    listen 443 ssl;
    server_name forum.example.org;
    # ssl_certificate / ssl_certificate_key: your certificate.

    location ~ ^/(login|register|verify) {
        limit_req zone=forum_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
    }

    location / {
        limit_req zone=forum_general burst=60 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
    }
}
